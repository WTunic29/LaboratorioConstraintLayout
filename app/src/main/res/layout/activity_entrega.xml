<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"

    >

    <TextView

        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Entrega actividad"
        android:textSize="22sp"
        android:textStyle="bold"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

    />

    <EditText

        android:id="@+id/studentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nombre estudiante"
        android:inputType="textPersonName"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_marginTop="16dp"

        />

    <EditText

        android:id="@+id/studentCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Código estudiantil"
        android:inputType="text"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/studentName"
        android:layout_marginTop="8dp"

        />

    <EditText

        android:id="@+id/activityName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Actividad formativa"
        android:inputType="text"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/studentCode"
        android:layout_marginTop="8dp"

        />

    <EditText

        android:id="@+id/deliveryDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Fecha de entrega"
        android:inputType="date"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activityName"
        android:layout_marginTop="8dp"

        />

    <EditText

        android:id="@+id/evidenceUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="URL de la evidencia o repositorio"
        android:inputType="textUri"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/deliveryDate"
        android:layout_marginTop="8dp"

        />

    <EditText

        android:id="@+id/observations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="Observaciones"
        android:gravity="top|start"
        android:inputType="textMultiLine"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/evidenceUrl"
        app:layout_constraintBottom_toTopOf="@id/registerButton"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"

        />

    <Button

        android:id="@+id/registerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar entrega"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        />

</androidx.constraintlayout.widget.ConstraintLayout>